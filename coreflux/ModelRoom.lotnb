[
  {
    "kind": 2,
    "language": "lot",
    "value": "DEFINE MODEL AcReading COLLAPSED\n    ADD STRING \"room_id\"\n    ADD DOUBLE \"temperature_c\"\n    ADD DOUBLE \"target_temperature_c\"\n    ADD INTEGER \"people_count\"\n    ADD STRING \"ac_mode\"\n    ADD STRING \"timestamp\""
  },
  {
    "kind": 2,
    "language": "lot",
    "value": "DEFINE ACTION ProcessAcReading\nON TOPIC \"campus/rooms/+/state\" DO\n    SET \"room_id\" WITH (GET JSON \"room_id\" IN PAYLOAD AS STRING)\n    SET \"temperature\" WITH (GET JSON \"temperature\" IN PAYLOAD AS DOUBLE)\n    SET \"target\" WITH (GET JSON \"target_temperature\" IN PAYLOAD AS DOUBLE)\n    SET \"people\" WITH (GET JSON \"people_count\" IN PAYLOAD AS INT)\n    SET \"ac_mode\" WITH (GET JSON \"ac_mode\" IN PAYLOAD AS STRING)\n    \n    PUBLISH MODEL AcReading TO (\"campus/reading/ac/\" + {room_id}) WITH\n        room_id = {room_id}\n        temperature_c = {temperature}\n        target_temperature_c = {target}\n        people_count = {people}\n        ac_mode = {ac_mode}\n        timestamp = TIMESTAMP \"UTC\"\n    "
  }
]