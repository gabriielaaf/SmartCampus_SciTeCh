[
  {
    "kind": 2,
    "language": "lot",
    "value": "DEFINE MODEL RoomState COLLAPSED\n    ADD STRING \"room_id\"\n    ADD INT \"people_count\"\n    ADD DOUBLE \"temperature_c\"\n    ADD DOUBLE \"co2\"\n    ADD DOUBLE \"empty_seconds\""
  },
  {
    "kind": 2,
    "language": "lot",
    "value": "DEFINE MODEL DeviceState COLLAPSED\n    ADD STRING \"room_id\"\n    ADD STRING \"ac_mode\"\n    ADD DOUBLE \"target_temperature_c\"\n    ADD BOOL \"lights_on\"\n    ADD BOOL \"door_locked\"\n    ADD BOOL \"alarm_on\""
  },
  {
    "kind": 2,
    "language": "lot",
    "value": "DEFINE ACTION TrackRoom\nON TOPIC \"campus/rooms/+/state\" DO\n    SET \"room_id\" WITH TOPIC POSITION 3\n    SET \"now\" WITH TIMESTAMP \"UNIX\"\n    SET \"people\" WITH (GET JSON \"people_count\" IN PAYLOAD AS INT)\n    SET \"temperature\" WITH (GET JSON \"temperature\" IN PAYLOAD AS DOUBLE)\n    SET \"co2\" WITH (GET JSON \"co2\" IN PAYLOAD AS DOUBLE)\n    SET \"ac_mode\" WITH (GET JSON \"ac_mode\" IN PAYLOAD AS STRING)\n    SET \"target\" WITH (GET JSON \"target_temperature\" IN PAYLOAD AS DOUBLE)\n    SET \"lights\" WITH (GET JSON \"lights_on\" IN PAYLOAD AS BOOL)\n    SET \"door\" WITH (GET JSON \"door_locked\" IN PAYLOAD AS BOOL)\n    SET \"alarm\" WITH (GET JSON \"alarm_on\" IN PAYLOAD AS BOOL)\n    SET \"empty_seconds\" WITH 0.0\n\n    IF {people} > 0 THEN\n        KEEP TOPIC \"campus/internal/\" + {room_id} + \"/last_occupied\" WITH {now}\n    ELSE\n        IF GET TOPIC \"campus/internal/+/last_occupied\" == EMPTY THEN\n            KEEP TOPIC \"campus/internal/\" + {room_id} + \"/last_occupied\" WITH {now}\n        ELSE\n            SET \"last_seen\" WITH (GET TOPIC \"campus/internal/+/last_occupied\" AS DOUBLE)\n            SET \"empty_seconds\" WITH ({now} - {last_seen})\n\n    KEEP TOPIC \"campus/internal/\" + {room_id} + \"/empty_seconds\" WITH {empty_seconds}\n    KEEP TOPIC \"campus/internal/\" + {room_id} + \"/ac_mode\" WITH {ac_mode}\n    KEEP TOPIC \"campus/internal/\" + {room_id} + \"/target\" WITH {target}\n    KEEP TOPIC \"campus/internal/\" + {room_id} + \"/lights\" WITH {lights}\n    KEEP TOPIC \"campus/internal/\" + {room_id} + \"/door\" WITH {door}\n    KEEP TOPIC \"campus/internal/\" + {room_id} + \"/alarm_on\" WITH {alarm}\n\n    PUBLISH MODEL DeviceState TO (\"campus/derived/\" + {room_id} + \"/device\") WITH\n        room_id = {room_id}\n        ac_mode = {ac_mode}\n        target_temperature_c = {target}\n        lights_on = {lights}\n        door_locked = {door}\n        alarm_on = {alarm}\n\n    PUBLISH MODEL RoomState TO (\"campus/derived/\" + {room_id} + \"/room\") WITH\n        room_id = {room_id}\n        people_count = {people}\n        temperature_c = {temperature}\n        co2 = {co2}\n        empty_seconds = {empty_seconds}"
  }
]