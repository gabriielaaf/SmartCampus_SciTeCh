[
  {
    "kind": 2,
    "language": "lot",
    "value": "DEFINE MODEL AcParams COLLAPSED\n    ADD STRING \"mode\""
  },
  {
    "kind": 2,
    "language": "lot",
    "value": "DEFINE MODEL LightsParams COLLAPSED\n    ADD BOOL \"enabled\""
  },
  {
    "kind": 2,
    "language": "lot",
    "value": "DEFINE MODEL DoorParams COLLAPSED\n    ADD BOOL \"locked\""
  },
  {
    "kind": 2,
    "language": "lot",
    "value": "DEFINE MODEL AlarmParams COLLAPSED\n    ADD BOOL \"enabled\"\n    ADD STRING \"reason\""
  },
  {
    "kind": 2,
    "language": "lot",
    "value": "DEFINE MODEL SetAcCommand COLLAPSED\n    ADD STRING \"command\"\n    ADD STRING \"room_id\"\n    ADD MODEL AcParams \"params\""
  },
  {
    "kind": 2,
    "language": "lot",
    "value": "DEFINE MODEL SetLightsCommand COLLAPSED\n    ADD STRING \"command\"\n    ADD STRING \"room_id\"\n    ADD MODEL LightsParams \"params\""
  },
  {
    "kind": 2,
    "language": "lot",
    "value": "DEFINE MODEL SetDoorCommand COLLAPSED\n    ADD STRING \"command\"\n    ADD STRING \"room_id\"\n    ADD MODEL DoorParams \"params\""
  },
  {
    "kind": 2,
    "language": "lot",
    "value": "DEFINE MODEL SetAlarmCommand COLLAPSED\n    ADD STRING \"command\"\n    ADD STRING \"room_id\"\n    ADD MODEL AlarmParams \"params\""
  },
  {
    "kind": 2,
    "language": "lot",
    "value": "DEFINE ACTION ControlRoom\nON TOPIC \"campus/derived/+/room\" DO\n    SET \"room_id\" WITH TOPIC POSITION 3\n    SET \"people\" WITH (GET JSON \"people_count\" IN PAYLOAD AS INT)\n    SET \"temperature\" WITH (GET JSON \"temperature_c\" IN PAYLOAD AS DOUBLE)\n    SET \"co2\" WITH (GET JSON \"co2\" IN PAYLOAD AS DOUBLE)\n    SET \"empty_seconds\" WITH (GET JSON \"empty_seconds\" IN PAYLOAD AS DOUBLE)\n\n    SET \"ac_mode\" WITH (GET TOPIC \"campus/internal/+/ac_mode\" AS STRING)\n    SET \"target\" WITH (GET TOPIC \"campus/internal/+/target\" AS DOUBLE)\n    SET \"lights\" WITH (GET TOPIC \"campus/internal/+/lights\" AS BOOL)\n    SET \"door\" WITH (GET TOPIC \"campus/internal/+/door\" AS BOOL)\n    SET \"alarm_on\" WITH (GET TOPIC \"campus/internal/+/alarm_on\" AS BOOL)\n\n    IF {target} < 1.0 THEN\n        SET \"target\" WITH 22.0\n\n    SET \"margin\" WITH 2.0\n    SET \"door_limit\" WITH 1800.0\n    SET \"co2_limit\" WITH 1500.0\n    SET \"co2_reset\" WITH ({co2_limit} - 100.0)\n    SET \"hot_limit\" WITH ({target} + {margin})\n    SET \"cold_limit\" WITH ({target} - {margin})\n\n    IF {temperature} > {hot_limit} THEN\n        IF {ac_mode} != \"ac_cool\" THEN\n            PUBLISH MODEL SetAcCommand TO (\"campus/rooms/\" + {room_id} + \"/commands\") WITH\n                command = \"SET_AC\"\n                room_id = {room_id}\n                params.mode = \"ac_cool\"\n    ELSE IF {temperature} < {cold_limit} THEN\n        IF {ac_mode} != \"ac_heat\" THEN\n            PUBLISH MODEL SetAcCommand TO (\"campus/rooms/\" + {room_id} + \"/commands\") WITH\n                command = \"SET_AC\"\n                room_id = {room_id}\n                params.mode = \"ac_heat\"\n    ELSE\n        IF {ac_mode} == \"ac_cool\" THEN\n            IF {temperature} <= {target} THEN\n                PUBLISH MODEL SetAcCommand TO (\"campus/rooms/\" + {room_id} + \"/commands\") WITH\n                    command = \"SET_AC\"\n                    room_id = {room_id}\n                    params.mode = \"ac_off\"\n        IF {ac_mode} == \"ac_heat\" THEN\n            IF {temperature} >= {target} THEN\n                PUBLISH MODEL SetAcCommand TO (\"campus/rooms/\" + {room_id} + \"/commands\") WITH\n                    command = \"SET_AC\"\n                    room_id = {room_id}\n                    params.mode = \"ac_off\"\n\n    IF {people} == 0 THEN\n        IF {lights} == TRUE THEN\n            PUBLISH MODEL SetLightsCommand TO (\"campus/rooms/\" + {room_id} + \"/commands\") WITH\n                command = \"SET_LIGHTS\"\n                room_id = {room_id}\n                params.enabled = FALSE\n\n    IF {empty_seconds} >= {door_limit} THEN\n        IF {door} == FALSE THEN\n            PUBLISH MODEL SetDoorCommand TO (\"campus/rooms/\" + {room_id} + \"/commands\") WITH\n                command = \"SET_DOOR\"\n                room_id = {room_id}\n                params.locked = TRUE\n\n    IF {co2} >= {co2_limit} THEN\n        IF {alarm_on} == FALSE THEN\n            PUBLISH MODEL SetAlarmCommand TO (\"campus/rooms/\" + {room_id} + \"/commands\") WITH\n                command = \"SET_ALARM\"\n                room_id = {room_id}\n                params.enabled = TRUE\n                params.reason = \"CO2 level exceeded threshold\"\n    ELSE IF {co2} < {co2_reset} THEN\n        IF {alarm_on} == TRUE THEN\n            PUBLISH MODEL SetAlarmCommand TO (\"campus/rooms/\" + {room_id} + \"/commands\") WITH\n                command = \"SET_ALARM\"\n                room_id = {room_id}\n                params.enabled = FALSE\n                params.reason = \"CO2 back to normal\""
  }
]