[
  {
    "kind": 2,
    "language": "lot",
    "value": "DEFINE MODEL RoomCommand COLLAPSED\n    ADD STRING \"command\"\n    ADD STRING \"room_id\"\n    ADD OBJECT \"params\""
  },
  {
    "kind": 2,
    "language": "lot",
    "value": "DEFINE ACTION ControlRoom\nON TOPIC \"campus/rooms/+/state\" DO\n    SET \"room_id\" WITH TOPIC POSITION 3\n    SET \"people\" WITH (GET JSON \"people_count\" IN PAYLOAD AS INT)\n    SET \"temperature\" WITH (GET JSON \"temperature\" IN PAYLOAD AS DOUBLE)\n    SET \"target\" WITH (GET JSON \"target_temperature\" IN PAYLOAD AS DOUBLE)\n    SET \"ac_mode\" WITH (GET JSON \"ac_mode\" IN PAYLOAD AS STRING)\n    SET \"lights\" WITH (GET JSON \"lights_on\" IN PAYLOAD AS BOOL)\n    SET \"empty_seconds\" WITH (GET TOPIC \"campus/internal/+/empty_seconds\" AS DOUBLE)\n\n    SET \"margin\" WITH 2.0\n    SET \"idle_limit\" WITH 600.0\n    SET \"hot_limit\" WITH ({target} + {margin})\n    SET \"cold_limit\" WITH ({target} - {margin})\n\n    IF {people} > 0 THEN\n        IF {lights} == FALSE THEN\n            PUBLISH MODEL RoomCommand TO (\"campus/rooms/\" + {room_id} + \"/commands\") WITH\n                command = \"SET_LIGHTS\"\n                room_id = {room_id}\n                params = {\n                    \"enabled\": true\n                }\n\n        IF {temperature} > {hot_limit} THEN\n            IF {ac_mode} != \"ac_cool\" THEN\n                PUBLISH MODEL RoomCommand TO (\"campus/rooms/\" + {room_id} + \"/commands\") WITH\n                    command = \"SET_AC\"\n                    room_id = {room_id}\n                    params = {\n                        \"mode\": \"ac_cool\"\n                    }\n        ELSE IF {temperature} < {cold_limit} THEN\n            IF {ac_mode} != \"ac_heat\" THEN\n                PUBLISH MODEL RoomCommand TO (\"campus/rooms/\" + {room_id} + \"/commands\") WITH\n                    command = \"SET_AC\"\n                    room_id = {room_id}\n                    params = {\n                        \"mode\": \"ac_heat\"\n                    }\n        ELSE\n            IF {ac_mode} == \"ac_cool\" THEN\n                IF {temperature} <= {target} THEN\n                    PUBLISH MODEL RoomCommand TO (\"campus/rooms/\" + {room_id} + \"/commands\") WITH\n                        command = \"SET_AC\"\n                        room_id = {room_id}\n                        params = {\n                            \"mode\": \"ac_off\"\n                        }\n            IF {ac_mode} == \"ac_heat\" THEN\n                IF {temperature} >= {target} THEN\n                    PUBLISH MODEL RoomCommand TO (\"campus/rooms/\" + {room_id} + \"/commands\") WITH\n                        command = \"SET_AC\"\n                        room_id = {room_id}\n                        params = {\n                            \"mode\": \"ac_off\"\n                        }\n    ELSE\n        IF {empty_seconds} >= {idle_limit} THEN\n            IF {ac_mode} != \"ac_off\" THEN\n                PUBLISH MODEL RoomCommand TO (\"campus/rooms/\" + {room_id} + \"/commands\") WITH\n                    command = \"SET_AC\"\n                    room_id = {room_id}\n                    params = {\n                        \"mode\": \"ac_off\"\n                    }\n            IF {lights} == TRUE THEN\n                PUBLISH MODEL RoomCommand TO (\"campus/rooms/\" + {room_id} + \"/commands\") WITH\n                    command = \"SET_LIGHTS\"\n                    room_id = {room_id}\n                    params = {\n                        \"enabled\": false\n                    }"
  }
]